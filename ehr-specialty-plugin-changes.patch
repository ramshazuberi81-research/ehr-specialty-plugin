+++ b/app/cds_auth.py
@@ -0,0 +1,149 @@
+"""Verify the signed JWT that a CDS Hooks client (the EHR) sends with every request.
+
+Spec: https://cds-hooks.hl7.org/2.0/#trusting-cds-clients
+
+The EHR sends `Authorization: Bearer <jwt>`, signed with its private key. We check:
+  - signature, against a JWKS from a URL WE trust (never one named only by the token: that would let
+    an attacker point us at their own keys)
+  - `iss` is an EHR we allow, `aud` is this service's endpoint URL
+  - `exp` and `iat` are present and the token is not expired
+  - `jti` has not been seen before (replay protection)
+Only RS384 and ES384 are accepted (the algorithms the spec requires clients to support); "none" and
+HMAC are rejected by construction.
+
+Configuration (environment variables). If CDS_JWT_ISSUERS is unset the service stays in prototype mode
+(shared secret header), so existing sandboxes keep working. Once it is set, ONLY a valid JWT is accepted
+and the shared secret no longer opens the CDS endpoint.
+  CDS_JWT_ISSUERS  comma-separated `iss` values to accept (e.g. https://ehr.example.org)
+  CDS_JWKS_URLS    comma-separated trusted JWKS URLs (https; http only for localhost)
+  CDS_AUDIENCE     comma-separated exact endpoint URL(s) the EHR calls, e.g.
+                   https://plugin.example.org/cds-services/ehr-previsit
+Missing JWKS or audience while issuers are set = 503 (fail closed, never fall back to open).
+
+Limits: the jti replay cache and JWKS cache live in this process. Behind several instances, move the
+jti store to a shared cache (e.g. Redis) before any pilot.
+"""
+import logging
+import os
+import threading
+import time
+from urllib.parse import urlparse
+
+import httpx
+import jwt
+from fastapi import HTTPException
+
+log = logging.getLogger("cds_auth")
+
+ALGORITHMS = ["RS384", "ES384"]
+MAX_LIFETIME = 600        # seconds: reject tokens valid for longer than 10 minutes (spec says short-lived)
+LEEWAY = 30               # seconds of clock skew tolerated
+JWKS_TTL = 300            # seconds a fetched JWKS is reused
+JWKS_MIN_REFRESH = 30     # seconds between forced refreshes (key rotation) per URL
+
+_jwks_cache: dict = {}    # url -> {"keys": dict, "at": float}
+_seen_jti: dict = {}      # jti -> exp
+_lock = threading.Lock()
+
+
+def _csv(name: str) -> list:
+    return [x.strip() for x in os.environ.get(name, "").split(",") if x.strip()]
+
+
+def jwt_mode() -> bool:
+    """True once CDS JWT auth is configured; from then on the shared secret is not accepted here."""
+    return bool(_csv("CDS_JWT_ISSUERS"))
+
+
+def _https_or_local(url: str) -> bool:
+    u = urlparse(url)
+    return u.scheme == "https" or (u.scheme == "http" and u.hostname in ("localhost", "127.0.0.1", "::1"))
+
+
+async def fetch_jwks(url: str) -> dict:
+    async with httpx.AsyncClient(timeout=10) as c:
+        r = await c.get(url, headers={"Accept": "application/json"})
+        r.raise_for_status()
+        return r.json()
+
+
+async def _keys_for(url: str, kid: str):
+    """Return the signing key with this kid from the trusted JWKS, refreshing once if it is unknown."""
+    now = time.time()
+    entry = _jwks_cache.get(url)
+    for attempt in (0, 1):
+        stale = not entry or now - entry["at"] > JWKS_TTL
+        if stale or attempt == 1:
+            if attempt == 1 and entry and now - entry["at"] < JWKS_MIN_REFRESH:
+                break  # refreshed very recently: do not let unknown kids hammer the EHR
+            entry = {"keys": await fetch_jwks(url), "at": time.time()}
+            _jwks_cache[url] = entry
+        for k in entry["keys"].get("keys", []):
+            if k.get("kid") == kid:
+                return jwt.PyJWK.from_dict(k).key
+    return None
+
+
+def _remember_jti(jti: str, exp: float) -> bool:
+    """False if this jti was already used (replay). Expired entries are dropped as we go."""
+    now = time.time()
+    with _lock:
+        for j in [j for j, e in _seen_jti.items() if e < now - LEEWAY]:
+            del _seen_jti[j]
+        if jti in _seen_jti:
+            return False
+        _seen_jti[jti] = exp
+        return True
+
+
+def _deny(reason: str):
+    log.warning("CDS JWT rejected: %s", reason)  # reason goes to our logs only, never to the caller
+    raise HTTPException(401, "unauthorized")
+
+
+async def verify_cds_jwt(authorization) -> dict:
+    """Validate the Bearer JWT. Returns its claims, or raises HTTPException (401 / 503)."""
+    issuers, jwks_urls, audiences = _csv("CDS_JWT_ISSUERS"), _csv("CDS_JWKS_URLS"), _csv("CDS_AUDIENCE")
+    if not (issuers and jwks_urls and audiences) or not all(_https_or_local(u) for u in jwks_urls):
+        raise HTTPException(503, "CDS JWT auth is not fully configured")
+    if not authorization or not authorization.lower().startswith("bearer "):
+        _deny("missing bearer token")
+    token = authorization[7:].strip()
+    try:
+        header = jwt.get_unverified_header(token)
+    except jwt.PyJWTError:
+        _deny("malformed token")
+    if header.get("alg") not in ALGORITHMS:
+        _deny(f"algorithm {header.get('alg')!r} not allowed")
+    kid = header.get("kid")
+    if not kid:
+        _deny("no kid")
+    jku = header.get("jku")
+    if jku and jku not in jwks_urls:
+        _deny("jku is not a trusted JWKS URL")  # token may NOT choose where we fetch keys from
+    try:
+        key = None
+        for url in ([jku] if jku else jwks_urls):
+            key = await _keys_for(url, kid)
+            if key is not None:
+                break
+    except (httpx.HTTPError, ValueError, jwt.PyJWTError) as e:
+        log.error("JWKS fetch failed: %s", e)
+        raise HTTPException(503, "cannot reach the EHR key set")
+    if key is None:
+        _deny("unknown kid")
+    try:
+        claims = jwt.decode(token, key, algorithms=ALGORITHMS, audience=audiences, issuer=issuers,
+                            leeway=LEEWAY, options={"require": ["exp", "iat", "iss", "aud", "jti"]})
+    except jwt.PyJWTError as e:
+        _deny(f"invalid token: {type(e).__name__}")
+    if claims["exp"] - claims["iat"] > MAX_LIFETIME:
+        _deny("token lifetime too long")
+    if not isinstance(claims["jti"], str) or not _remember_jti(claims["jti"], claims["exp"]):
+        _deny("jti reused or invalid")
+    return claims
+
+
+def _reset_for_tests() -> None:
+    _jwks_cache.clear()
+    _seen_jti.clear()
