+++ b/tests/test_cds_auth.py
@@ -0,0 +1,205 @@
+"""CDS Hooks JWT verification: the attacks that matter, plus the happy paths. All offline, synthetic keys."""
+import base64
+import hashlib
+import hmac
+import json
+import time
+import uuid
+
+import jwt
+import pytest
+from cryptography.hazmat.primitives import serialization
+from cryptography.hazmat.primitives.asymmetric import ec, rsa
+from fastapi.testclient import TestClient
+from jwt.algorithms import ECAlgorithm, RSAAlgorithm
+
+import app.cds_auth as cds_auth
+import app.main as main
+
+ISS = "https://ehr.test"
+AUD = "https://plugin.test/cds-services/ehr-previsit"
+JWKS_URL = "https://ehr.test/.well-known/jwks.json"
+URL = "/cds-services/ehr-previsit"
+BODY = {"hook": "patient-view", "context": {"userId": "Practitioner/eye", "patientId": "p1"}}
+
+RSA_KEY = rsa.generate_private_key(public_exponent=65537, key_size=2048)
+EC_KEY = ec.generate_private_key(ec.SECP384R1())
+OTHER_RSA = rsa.generate_private_key(public_exponent=65537, key_size=2048)  # the attacker's key
+
+
+def jwk(key, kid, alg):
+    algo = RSAAlgorithm if alg.startswith("RS") else ECAlgorithm
+    return {**algo.to_jwk(key.public_key(), as_dict=True), "kid": kid, "alg": alg, "use": "sig"}
+
+
+JWKS = {"keys": [jwk(RSA_KEY, "rsa-1", "RS384"), jwk(EC_KEY, "ec-1", "ES384")]}
+
+
+def token(key=RSA_KEY, alg="RS384", kid="rsa-1", headers=None, **claims):
+    now = int(time.time())
+    c = {"iss": ISS, "aud": AUD, "iat": now, "exp": now + 300, "jti": uuid.uuid4().hex, **claims}
+    c = {k: v for k, v in c.items() if v is not None}  # pass claim=None to drop it
+    return jwt.encode(c, key, algorithm=alg, headers={"kid": kid, **(headers or {})})
+
+
+@pytest.fixture
+def client(monkeypatch):
+    monkeypatch.setenv("CDS_JWT_ISSUERS", ISS)
+    monkeypatch.setenv("CDS_JWKS_URLS", JWKS_URL)
+    monkeypatch.setenv("CDS_AUDIENCE", AUD)
+    cds_auth._reset_for_tests()
+    calls = {"n": 0, "jwks": JWKS}
+
+    async def fake_fetch(url):
+        calls["n"] += 1
+        assert url == JWKS_URL, "must only ever fetch a JWKS URL we configured"
+        return calls["jwks"]
+
+    async def fake_cards(client, body):
+        return {"cards": []}
+
+    monkeypatch.setattr(cds_auth, "fetch_jwks", fake_fetch)
+    monkeypatch.setattr(main, "build_cards", fake_cards)
+    c = TestClient(main.app)
+    c.calls = calls
+    yield c
+    cds_auth._reset_for_tests()
+
+
+def post(client, tok=None, **headers):
+    h = dict(headers)
+    if tok is not None:
+        h["Authorization"] = f"Bearer {tok}"
+    return client.post(URL, json=BODY, headers=h)
+
+
+# ------------------------------------------------------------------ accepted
+def test_valid_rs384_accepted(client):
+    r = post(client, token())
+    assert r.status_code == 200 and r.json() == {"cards": []}
+
+
+def test_valid_es384_accepted(client):
+    assert post(client, token(EC_KEY, "ES384", "ec-1")).status_code == 200
+
+
+def test_discovery_stays_open_without_auth(client):
+    assert client.get("/cds-services").status_code == 200
+
+
+# ------------------------------------------------------------------ rejected
+def test_no_token_rejected(client):
+    assert post(client).status_code == 401
+
+
+def test_shared_secret_no_longer_opens_cds_endpoint_in_jwt_mode(client):
+    assert post(client, **{"X-Webhook-Secret": "test-secret"}).status_code == 401
+
+
+def test_garbage_token_rejected(client):
+    assert post(client, "not.a.jwt").status_code == 401
+
+
+def test_wrong_audience_rejected(client):
+    assert post(client, token(aud="https://someone-else.test/cds-services/x")).status_code == 401
+
+
+def test_wrong_issuer_rejected(client):
+    assert post(client, token(iss="https://evil.test")).status_code == 401
+
+
+def test_expired_rejected(client):
+    now = int(time.time())
+    assert post(client, token(iat=now - 1000, exp=now - 500)).status_code == 401
+
+
+def test_lifetime_too_long_rejected(client):
+    now = int(time.time())
+    assert post(client, token(iat=now, exp=now + 3600)).status_code == 401
+
+
+@pytest.mark.parametrize("claim", ["jti", "exp", "iat", "iss", "aud"])
+def test_missing_required_claim_rejected(client, claim):
+    assert post(client, token(**{claim: None})).status_code == 401
+
+
+def test_replayed_jti_rejected(client):
+    t = token()
+    assert post(client, t).status_code == 200
+    assert post(client, t).status_code == 401
+
+
+def test_signed_by_attacker_key_with_our_kid_rejected(client):
+    assert post(client, token(OTHER_RSA, "RS384", "rsa-1")).status_code == 401
+
+
+def test_alg_none_rejected(client):
+    now = int(time.time())
+    forged = jwt.encode({"iss": ISS, "aud": AUD, "iat": now, "exp": now + 300, "jti": "x"},
+                        key=None, algorithm="none", headers={"kid": "rsa-1"})
+    assert post(client, forged).status_code == 401
+
+
+def test_hmac_with_public_key_as_secret_rejected(client):
+    # Algorithm-confusion attack: an HS256 token "signed" with the EHR's public key bytes.
+    pub_pem = RSA_KEY.public_key().public_bytes(serialization.Encoding.PEM,
+                                                serialization.PublicFormat.SubjectPublicKeyInfo)
+    now = int(time.time())
+    b64 = lambda b: base64.urlsafe_b64encode(b).rstrip(b"=")
+    head = b64(json.dumps({"alg": "HS256", "typ": "JWT", "kid": "rsa-1"}).encode())
+    pay = b64(json.dumps({"iss": ISS, "aud": AUD, "iat": now, "exp": now + 300, "jti": "z"}).encode())
+    sig = b64(hmac.new(pub_pem, head + b"." + pay, hashlib.sha256).digest())
+    assert post(client, (head + b"." + pay + b"." + sig).decode()).status_code == 401
+
+
+def test_untrusted_jku_rejected_and_never_fetched(client):
+    r = post(client, token(headers={"jku": "https://attacker.test/jwks.json"}))
+    assert r.status_code == 401 and client.calls["n"] == 0
+
+
+def test_trusted_jku_accepted(client):
+    assert post(client, token(headers={"jku": JWKS_URL})).status_code == 200
+
+
+def test_unknown_kid_rejected(client):
+    assert post(client, token(kid="nope")).status_code == 401
+
+
+def test_key_rotation_refreshes_jwks_once(client):
+    assert post(client, token()).status_code == 200            # warms the cache
+    new_key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
+    client.calls["jwks"] = {"keys": JWKS["keys"] + [jwk(new_key, "rsa-2", "RS384")]}
+    cds_auth._jwks_cache[JWKS_URL]["at"] -= 100                # older than the refresh floor, within TTL
+    assert post(client, token(new_key, "RS384", "rsa-2")).status_code == 200
+
+
+def test_unknown_kid_cannot_hammer_the_ehr(client):
+    post(client, token())                                      # one fetch to warm the cache
+    before = client.calls["n"]
+    for _ in range(5):
+        post(client, token(kid="nope"))
+    assert client.calls["n"] == before                         # refresh floor blocks repeated refetches
+
+
+# ------------------------------------------------------------------ configuration fails closed
+@pytest.mark.parametrize("missing", ["CDS_JWKS_URLS", "CDS_AUDIENCE"])
+def test_partial_config_is_503_not_open(client, monkeypatch, missing):
+    monkeypatch.delenv(missing)
+    assert post(client, token()).status_code == 503
+
+
+def test_plain_http_jwks_url_refused(client, monkeypatch):
+    monkeypatch.setenv("CDS_JWKS_URLS", "http://ehr.test/jwks.json")
+    assert post(client, token()).status_code == 503
+
+
+def test_prototype_mode_unchanged_when_jwt_not_configured(monkeypatch):
+    for v in ("CDS_JWT_ISSUERS", "CDS_JWKS_URLS", "CDS_AUDIENCE"):
+        monkeypatch.delenv(v, raising=False)
+
+    async def fake_cards(client, body):
+        return {"cards": []}
+    monkeypatch.setattr(main, "build_cards", fake_cards)
+    c = TestClient(main.app)
+    assert c.post(URL, json=BODY).status_code == 401
+    assert c.post(URL, json=BODY, headers={"X-Webhook-Secret": "test-secret"}).status_code == 200
