# Copy to .env and edit. Never commit .env.
FHIR_BASE=http://localhost:8080/fhir
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Dev mode (no auth) when SMART_CLIENT_ID is unset. Optional static token:
# FHIR_TOKEN=

# SMART Backend Services (production-style auth). Generate keys: python scripts/gen_keys.py
# SMART_CLIENT_ID=
# SMART_PRIVATE_KEY=private_key.pem
# SMART_KID=plugin-key-1

# Optional NLP layer (/ask, /nlp/*). Unset = NLP endpoints return 503.
# ANTHROPIC_API_KEY=
# NLP_MODEL=claude-sonnet-5-5

# CDS Hooks JWT verification (production-style). Set all three to require the EHR's signed JWT on
# /cds-services/ehr-previsit; leave unset for sandbox mode (X-Webhook-Secret).
# CDS_JWT_ISSUERS=https://ehr.example.org
# CDS_JWKS_URLS=https://ehr.example.org/.well-known/jwks.json
# CDS_AUDIENCE=https://plugin.example.org/cds-services/ehr-previsit
